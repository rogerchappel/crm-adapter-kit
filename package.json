{
  "name": "crm-adapter-kit",
  "version": "0.1.0",
  "description": "Provider-neutral CRM primitives and dry-run action plans for agents.",
  "type": "module",
  "bin": {
    "crm-adapter-kit": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/*.js bin/cli.js tests/*.test.js",
    "build": "node scripts/build.js",
    "smoke": "node bin/cli.js --help && node scripts/smoke.js",
    "package:smoke": "node scripts/package-smoke.js",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "agents",
    "cli",
    "dry-run"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/crm-adapter-kit.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/crm-adapter-kit/issues"
  },
  "homepage": "https://github.com/rogerchappel/crm-adapter-kit#readme"
}
